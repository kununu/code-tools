#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * Checks the project in the current directory against the company-wide architecture rules.
 *
 * Usage: architecture-check [--error-format=<format>] [--memory-limit=<limit>]
 */

use Kununu\CodeTools\Architecture\ArchitectureCheck;

require $_composer_autoload_path ?? dirname(__DIR__) . '/vendor/autoload.php';

$projectDirectory = getcwd();
if ($projectDirectory === false) {
    fwrite(STDERR, 'Could not determine the current directory.' . PHP_EOL);
    exit(2);
}

try {
    exit(
        ArchitectureCheck::create(
            $projectDirectory,
            sys_get_temp_dir(),
            static fn(string $text) => fwrite(STDERR, $text)
        )
            ->run(array_slice($argv, 1))
    );
} catch (LogicException|RuntimeException $exception) {
    fwrite(STDERR, $exception->getMessage() . PHP_EOL);
    exit(2);
}
