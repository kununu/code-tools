#!/usr/bin/env bash

set -euo pipefail

# Resolve project root
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"

# Constants
if [ -d "$PROJECT_ROOT/services/vendor/kununu/code-tools" ]; then
  readonly CONFIG_DIR="$PROJECT_ROOT/services/vendor/kununu/code-tools"
elif [ -d "$PROJECT_ROOT/vendor/kununu/code-tools" ]; then
  readonly CONFIG_DIR="$PROJECT_ROOT/vendor/kununu/code-tools"
elif [ -d "$PROJECT_ROOT/dist" ]; then
  # Running from inside the code-tools repository itself
  readonly CONFIG_DIR="$PROJECT_ROOT"
else
  echo "❌ Could not find 'vendor/kununu/code-tools'."
  exit 1
fi

# Single source of truth: "<tool-name>:<template>". Drives the help text, the
# tool-name lookup and the publish-everything loop, so they cannot drift apart.
readonly CONFIG_FILES=(
    "cs-fixer:dist/php-cs-fixer.php.dist"
    "code-sniffer:dist/phpcs.xml.dist"
    "psalm:dist/psalm.xml.dist"
    "rector:dist/rector.php.dist"
    "phpstan:dist/phpstan.neon.dist"
    "editorconfig:dist/.editorconfig.dist"
)

# Function to display help instructions
show_help() {
    cat <<EOF
Usage: vendor/bin/code-tools publish:config [tool-name]

Publishes a tool's configuration template into the project. Without a tool name,
every configuration below is published.

Valid tool names:
EOF
    local entry
    for entry in "${CONFIG_FILES[@]}"; do
        printf '  %-13s => copies %s\n' "${entry%%:*}" "${entry#*:}"
    done
}

# Function to resolve a tool name to its template, printing it on success
resolve_config_file() {
    local tool="$1"
    local entry

    for entry in "${CONFIG_FILES[@]}"; do
        if [ "${entry%%:*}" = "$tool" ]; then
            echo "${entry#*:}"

            return 0
        fi
    done

    return 1
}

# Function to copy a config file
copy_config_file() {
    local source_file="$CONFIG_DIR/$1"
    local dest_file="${1#dist/}"
    dest_file="${dest_file%.dist}"
    local dest_path="$PROJECT_ROOT/$dest_file"

    if [ -f "$dest_path" ]; then
        echo "⚠️  Config file '$dest_file' already exists at project level."
    elif [ -f "$source_file" ]; then
        cp "$source_file" "$dest_path"
        echo "✅ Config file '$dest_file' copied to project level."
    else
        echo "❌ Config file '$source_file' does not exist."
    fi
}

# Parse arguments
if [ "${1:-}" == "--help" ]; then
    show_help
    exit 0
fi

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    show_help
    exit 1
fi

if [ "$1" != "publish:config" ]; then
    echo "❌ Invalid command. Valid command: publish:config"
    exit 1
fi

# No tool name: publish every configuration
if [ "$#" -eq 1 ]; then
    for entry in "${CONFIG_FILES[@]}"; do
        copy_config_file "${entry#*:}"
    done

    exit 0
fi

tool_name="$2"

if ! config_file="$(resolve_config_file "$tool_name")"; then
    echo "❌ Invalid tool name: '$tool_name'"
    show_help
    exit 1
fi

copy_config_file "$config_file"
