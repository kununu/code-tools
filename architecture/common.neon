# Company-wide architecture rules that apply to every project layout.
# Run through vendor/bin/architecture-check, which passes the directory to analyse and sets the two
# environment variables used below.
includes:
    - %env.ARCHITECTURE_CHECK_PHPAT_EXTENSION%

parameters:
    customRulesetUsed: true
    tmpDir: %env.ARCHITECTURE_CHECK_TMP_DIR%
    # Only PHPAT rules run here, so an inline @phpstan-ignore written for the project's regular PHPStan run
    # matches nothing. Inline comments are the only ignores that reach this run: the project's config is not read.
    reportUnmatchedIgnoredErrors: false
    phpat:
        show_rule_names: true

services:
    -
        class: Kununu\CodeTools\Architecture\Rules\CommonRules
        tags:
            - phpat.test
